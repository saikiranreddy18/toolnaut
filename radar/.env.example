# Every value here is OPTIONAL. With none set, the pipeline runs on public
# no-key sources (Hacker News + GitHub) and deterministic fallback enrichment,
# routing new tools to the review queue. Add keys to unlock more.

# --- LLM enrichment (provider-agnostic; first one set wins) ---
# Priority order: Featherless -> Anthropic -> NVIDIA -> OpenAI -> OpenRouter.
# Set ONLY the one you want to use (leave the others blank).

# NVIDIA (build.nvidia.com — OpenAI-compatible). Get a key at build.nvidia.com.
NVIDIA_API_KEY=
# Any model id from the NVIDIA catalog, e.g.:
#   meta/llama-3.1-70b-instruct        (solid default)
#   nvidia/llama-3.1-nemotron-70b-instruct
#   deepseek-ai/deepseek-r1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Featherless (api.featherless.ai — OpenAI-compatible, flat-rate). Note the
# default model is a REASONING model: radar floors its token budget at 1024 so
# the hidden reasoning pass does not eat the whole answer.
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=moonshotai/Kimi-K3

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# --- Sources ---
GITHUB_TOKEN=            # optional — raises GitHub's rate limit
PRODUCTHUNT_TOKEN=       # required to enable the Product Hunt source
RSS_FEEDS=               # comma-separated feed URLs (optional)

# --- Tuning ---
RADAR_PUBLISH_THRESHOLD=0.75
RADAR_REVIEW_THRESHOLD=0.4
RADAR_MAX_CANDIDATES=100
RADAR_DATA_DIR=          # defaults to ./data
RADAR_LOG=info           # debug | info | warn | error
