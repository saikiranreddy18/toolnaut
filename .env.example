# Copy to .env and fill in. These are baked into the client bundle at build
# time, so only ever put PUBLIC values here.

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA4_ID=

# Supabase — real Google sign-in. Both values are browser-safe; the anon key is
# designed to ship in client code and Row Level Security is what protects data.
# Setup steps: docs/supabase-setup.md
#
# Leave both blank and the app runs on a simulated local session, which is how
# local dev and preview deploys work with no credentials at all.
#
# The Supabase->Vercel integration injects NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_ANON_KEY instead; vite.config.js reads that prefix too,
# so the integration needs no manual entry here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Payments (Razorpay Standard Checkout) ────────────────────────────────────
# The key id is public and must reach the browser to open the modal. The SECRET
# is server-only: never give it a VITE_ prefix, because Vite inlines every
# VITE_* variable into the client bundle at build time.
#
#   RAZORPAY_KEY_ID          rzp_test_... then rzp_live_...
#   RAZORPAY_KEY_SECRET      server only, never VITE_
#   VITE_RAZORPAY_KEY_ID     same key id, browser-safe
#   RAZORPAY_AMOUNT_PAISE    the price, in paise, decided by the SERVER.
#                            Never accept an amount from the browser.
#   RAZORPAY_CURRENCY        defaults to INR
#
# Unset them and /api/razorpay-order and /api/razorpay-verify return 503
# "Payments not configured", and the app runs exactly as it does today.
