# Copy to .env and fill in. These are baked into the client bundle at build
# time, so only ever put PUBLIC values here.

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA4_ID=

# Waitlist submission endpoint (Formspree, Buttondown, /api route, ...).
# REQUIRED IN PRODUCTION: with this unset the form still says "You're on the
# list" but the email is only written to the visitor's own localStorage and is
# lost forever. Set this in the Vercel project env before launch.
VITE_WAITLIST_ENDPOINT=
