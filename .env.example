# Copy to .env and fill in. These are baked into the client bundle at build
# time, so only ever put PUBLIC values here.

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA4_ID=

# Supabase — real Google sign-in. Both values are browser-safe; the anon key is
# designed to ship in client code and Row Level Security is what protects data.
# Setup steps: docs/supabase-setup.md
#
# Leave both blank and the app runs on a simulated local session, which is how
# local dev and preview deploys work with no credentials at all.
#
# The Supabase->Vercel integration injects NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_ANON_KEY instead; vite.config.js reads that prefix too,
# so the integration needs no manual entry here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Razorpay checkout. BOTH are server-only and are read by the /api functions —
# note there is no VITE_ prefix on either, deliberately. The browser is handed
# the key id by /api/create-order at checkout time, so it never needs to be
# baked into the bundle, and the secret must never be.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Payment-to-entitlement pipeline (api/create-order, verify-payment,
# razorpay-webhook, entitlement). Run supabase/payments.sql first.
# PAYMENTS_ENABLED must be exactly 'true' to allow order creation AND to arm
# the sign-in paywall — anything else means off, and the paywall blocks nobody.
# RAZORPAY_WEBHOOK_SECRET comes from Razorpay Dashboard -> Webhooks when you
# point a webhook at /api/razorpay-webhook (payment.captured, payment.failed,
# refund.processed). SUPABASE_SERVICE_ROLE_KEY is shared with the alerts
# feature below.
PAYMENTS_ENABLED=
RAZORPAY_WEBHOOK_SECRET=

# New-tool email alerts (api/alerts-*.js). ALL server-only, no VITE_ prefix.
# Until these exist the subscribe endpoint answers 503 and the UI says the
# feature isn't live yet — nothing pretends to work.
#
# 1. Run supabase/alert_subscribers.sql in Supabase -> SQL Editor.
# 2. SUPABASE_SERVICE_ROLE_KEY: Supabase -> Settings -> API -> service_role.
#    SERVER-ONLY SECRET — bypasses RLS. Never with a VITE_ prefix, ever.
#    (SUPABASE_URL can be omitted: the functions fall back to VITE_SUPABASE_URL.)
# 3. RESEND_API_KEY: resend.com free tier (100 emails/day). RESEND_FROM stays
#    on onboarding@resend.dev until toolnaut.xyz is verified in Resend.
# 4. CRON_SECRET: any long random string. Vercel automatically sends it as the
#    Bearer token when its cron (vercel.json "crons") calls /api/alerts-send.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM=
CRON_SECRET=
