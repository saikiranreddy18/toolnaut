    "react-router-dom": "^7.18.1",
    "three": "^0.177.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  }
